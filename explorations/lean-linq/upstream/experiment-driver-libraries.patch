-      pure #[sqlite, pq, tds, my, "-Wl,--allow-shlib-undefined"]
-  return Lean.toExpr args
+/-- The shared library for a database client, looked up only when a target links it. Linking it
+by path keeps the system library directory, and with it the system glibc, out of the search path. -/
+def findClientLib (names : List String) (what : String) : IO System.FilePath := do
+  let mut dirs := #["/usr/lib/x86_64-linux-gnu", "/usr/lib/aarch64-linux-gnu", "/usr/lib64", "/usr/lib"]
+  if what == "libpq" then
+    try
+      let out ← IO.Process.output { cmd := "pg_config", args := #["--libdir"] }
+      dirs := dirs.push out.stdout.trimAscii.toString
+    catch _ => pure ()
+  for d in dirs do
+    for n in names do
+      let f : System.FilePath := d ++ "/" ++ n
+      if ← f.pathExists then return f
+  throw <| IO.userError s!"{what} not found (install the -dev package); searched {dirs}"
 
 -- Include directory for libpq headers, resolved the same way (Linux:
 -- `pg_config --includedir`, falling back to the Debian default).
@@ -103,7 +69,20 @@ package «lean-linq» where
   homepage := "https://github.com/palladin/lean-linq"
   license := "MIT"
   testDriver := "tests"
-  moreLinkArgs := dbLinkArgs%
+  -- System client libraries can need newer glibc symbols than the toolchain's own glibc.
+  moreLinkArgs := #["-Wl,--allow-shlib-undefined"]
+
+target libpqClient : System.FilePath := do
+  return Job.pure (← findClientLib ["libpq.so", "libpq.so.5"] "libpq")
+
+target sqliteClient : System.FilePath := do
+  return Job.pure (← findClientLib ["libsqlite3.so", "libsqlite3.so.0"] "libsqlite3")
+
+target freetdsClient : System.FilePath := do
+  return Job.pure (← findClientLib ["libsybdb.so", "libsybdb.so.5"] "libsybdb (freetds)")
+
+target mysqlClient : System.FilePath := do
+  return Job.pure (← findClientLib ["libmysqlclient.so", "libmysqlclient.so.21"] "libmysqlclient")
 
