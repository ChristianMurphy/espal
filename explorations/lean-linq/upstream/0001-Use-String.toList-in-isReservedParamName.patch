From 8a0b7de4ee20c97867ee4400a1c06fdb6c3e1985 Mon Sep 17 00:00:00 2001
From: Christian Murphy <christian.murphy.42@gmail.com>
Date: Sun, 18 Oct 2026 22:39:14 +0000
Subject: [PATCH] Use String.toList in isReservedParamName

String.data is deprecated in Lean 4.35.0 and removed in 4.36.0-rc1. String.toList works on both.

Signed-off-by: Christian Murphy <christian.murphy.42@gmail.com>
---
 LeanLinq/Core/Expr.lean | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/LeanLinq/Core/Expr.lean b/LeanLinq/Core/Expr.lean
index bb47303..e37881e 100644
--- a/LeanLinq/Core/Expr.lean
+++ b/LeanLinq/Core/Expr.lean
@@ -407,7 +407,7 @@ instance : FlagFits true true := ⟨id, id⟩
 literal); a user parameter with such a name would silently alias a
 literal's placeholder in the compiled SQL, so the door refuses them. -/
 def _root_.String.isReservedParamName (s : String) : Bool :=
-  match s.data with
+  match s.toList with
   | 'p' :: rest => !rest.isEmpty && rest.all Char.isDigit
   | _ => false
 
-- 
2.43.0

